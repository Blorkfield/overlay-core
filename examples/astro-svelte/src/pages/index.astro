---
import OverlayCanvas from '../components/OverlayCanvas.svelte';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Overlay Core Astro + Svelte Example</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html, body {
        width: 100%;
        height: 100%;
        overflow: hidden;
        font-family: system-ui, sans-serif;
      }

      main {
        width: 100%;
        height: 100%;
      }
    </style>
  </head>
  <body>
    <main>
      <OverlayCanvas
        client:load
        text="Astro + Svelte"
        rainEnabled={true}
        spawnRate={4}
      />
    </main>
  </body>
</html>

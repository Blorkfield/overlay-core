{
  "name": "@blorkfield/overlay-core",
  "version": "0.8.11",
  "license": "GPL-3.0",
  "description": "Physics-based overlay scene library for interactive streaming overlays",
  "repository": {
    "type": "git",
    "url": "https://github.com/Blorkfield/overlay-core.git"
  },
  "keywords": [
    "overlay",
    "physics",
    "matter-js",
    "streaming",
    "interactive"
  ],
  "packageManager": "pnpm@10.28.2",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vite": {
      "types": "./dist/vite-plugin.d.ts",
      "import": "./dist/vite-plugin.js",
      "require": "./dist/vite-plugin.cjs"
    },
    "./fonts": "./fonts",
    "./fonts/*": "./fonts/*",
    "./public": "./public",
    "./public/*": "./public/*"
  },
  "files": [
    "dist",
    "fonts",
    "public"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "concurrently \"tsup --watch\" \"pnpm -C test-app dev\"",
    "typecheck": "tsc --noEmit",
    "prepare": "[ -d test-app ] && pnpm -C test-app install || true"
  },
  "dependencies": {
    "matter-js": "^0.19.0",
    "opentype.js": "^1.3.4",
    "sirv": "^3.0.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@types/matter-js": "^0.19.8",
    "@types/node": "^20.19.30",
    "@types/opentype.js": "^1.3.9",
    "concurrently": "^9.2.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
